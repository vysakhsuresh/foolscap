# Served by Cloudflare Pages, and by `vite preview` through scripts/vite-cf-headers.mjs
# so the e2e tests run under the same policy production will.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=(), usb=()

# The tool pages. Scripts, styles, fonts and workers come only from this
# origin. connect-src is this origin and blob: because pdf.js fetches its own
# worker, cmaps and standard fonts from here and reads documents through blob
# URLs; there is nothing else to connect to. No inline styles or scripts.
/tools/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' blob: data:; font-src 'self'; connect-src 'self' blob:; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; object-src 'none'
  Cross-Origin-Opener-Policy: same-origin

# Hashed assets never change; cache them for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
