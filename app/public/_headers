# Served by Cloudflare Pages, and by `vite preview` through scripts/vite-cf-headers.ts
# so the e2e tests run under the same policy production will.
#
# Cloudflare applies every block whose path matches, and a header named in two
# matching blocks is sent with both values joined by a comma - for a
# Content-Security-Policy that means two policies, both enforced. So the
# policy is never on /*: each path gets exactly one, below.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=(), usb=()

# The strict policy: every tool page, and every script, worker, font and asset
# - because a dedicated worker's CSP comes from its own script's response, not
# from the page that made it, and the op worker and pdf.js's worker, where the
# document bytes actually are, live under /assets/. Scripts, styles, fonts,
# workers and connections come only from this origin. No inline styles or
# scripts. tests/unit/rules.test.ts fails if a path the build writes is left
# without it.
/tools/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' blob: data:; font-src 'self'; connect-src 'self'; worker-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; object-src 'none'
  Cross-Origin-Opener-Policy: same-origin
  Referrer-Policy: no-referrer

/assets/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' blob: data:; font-src 'self'; connect-src 'self'; worker-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; object-src 'none'
